# Built artifacts — regenerated each run, deployed via SFTP, never committed.
dist/

# state.json is intentionally committed (change-detection persistence), and it
# carries repo_license_digests -- the audit trail for what attribution each pack
# was built against. The cache below is just the working copy of those files,
# repopulated from the clone on every build.
.license-cache/

__pycache__/
*.pyc

# `mcp-publisher login` writes LIVE credentials into the working directory: a
# GitHub token and a registry JWT. Untracked is not enough -- `git add -A` would
# stage both. The other three suite repos have carried these two lines for
# months; this repo did not, found by a sweep on 2026-08-15.
.mcpregistry_github_token
.mcpregistry_registry_token
